# Example settings. Set as OS environment variables; .env is not automatically loaded.
MAX_UPLOAD_MB=10
ESP32_CAPTURE_URL=http://192.168.1.153/capture
# Optional for direct device POST with X-Source: esp32:
DEVICE_API_KEY=change-this-random-secret
# MODEL_ID can be omitted to use models/bioclip-2 on this machine.
# MODEL_ID=local-dir:C:/absolute/path/to/medicinal_bioclip2/models/bioclip-2
